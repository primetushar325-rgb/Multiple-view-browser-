<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/paneHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pane_header_height"
        android:background="@drawable/bg_pane_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/paneBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="P1" />

        <TextView
            android:id="@+id/paneAvatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="A" />

        <ImageView
            android:id="@+id/paneIcon"
            android:layout_width="@dimen/pane_icon"
            android:layout_height="@dimen/pane_icon"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_globe"
            app:tint="?attr/mvIconTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/paneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="mail.google.com" />

            <TextView
                android:id="@+id/paneAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="account1@gmail.com" />
        </LinearLayout>

        <ImageView
            android:id="@+id/paneProfile"
            android:layout_width="@dimen/pane_button"
            android:layout_height="@dimen/pane_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pane_profile"
            android:padding="6dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/mvIconTint" />

        <ImageView
            android:id="@+id/paneReload"
            android:layout_width="@dimen/pane_button"
            android:layout_height="@dimen/pane_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pane_reload"
            android:padding="6dp"
            android:src="@drawable/ic_reload"
            app:tint="?attr/mvIconTint" />

        <ImageView
            android:id="@+id/paneMaximize"
            android:layout_width="@dimen/pane_button"
            android:layout_height="@dimen/pane_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pane_maximize"
            android:padding="6dp"
            android:src="@drawable/ic_maximize"
            app:tint="?attr/mvIconTint" />

        <ImageView
            android:id="@+id/paneClose"
            android:layout_width="@dimen/pane_button"
            android:layout_height="@dimen/pane_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pane_close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/mvIconTint" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/paneWebHolder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/mvPaneBackground">

        <!-- Covers the WebView while loading and offers recovery on failure,
             so a pane never sits there as a blank black rectangle.
             The WebView itself is inserted below this at index 0. -->
        <LinearLayout
            android:id="@+id/paneState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/mvPaneBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/paneSpinner"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/paneStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="?attr/mvIconTint"
                android:textSize="12sp"
                tools:text="Loading…" />

            <LinearLayout
                android:id="@+id/paneStateActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paneRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="120dp"
                    android:text="@string/err_retry"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paneOpenExternal"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:minWidth="120dp"
                    android:text="@string/err_open_external"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</merge>
